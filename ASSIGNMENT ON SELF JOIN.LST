SQL> -- 3. WAQTD NAME OF THE EMP AND MANAGERS SALARY IF EMPLOYEE AND MANAGER BOTH EARN MORE THAN 2300.
  1  SELECT E.ENAME ,M.SAL
  2  FROM EMP E ,EMP M
  3  WHERE E.MGR=M.EMPNO
  4* AND (E.SAL >2300) AND (M.SAL>2300)
SQL> /

ENAME             SAL                                                                                                                                                                                   
---------- ----------                                                                                                                                                                                   
SCOTT            2975                                                                                                                                                                                   
FORD             2975                                                                                                                                                                                   
BLAKE            5000                                                                                                                                                                                   
JONES            5000                                                                                                                                                                                   
CLARK            5000  

                                                                                                                                                                                 

SQL> --4. WAQTD EMP NAME AND MANAGER'S HIREDATE IF EMPLOYEE WAS HIRED BEFORE 1982.
