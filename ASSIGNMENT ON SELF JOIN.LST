SQL> --6. WAQTD EMP NAME AND MANAGER NAME AND THEIR SALARIES IF EMPLOYEE EARNS MORE THAN MANAGER.
SQL> SELECT E.ENAME,M.ENAME,M.SAL
  2  FROM EMP E,EMP M
  3  WHERE E.MGR=M.EMPNO
  4  AND E.SAL > M.SAL;

