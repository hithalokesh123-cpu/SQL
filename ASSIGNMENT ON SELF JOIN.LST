SQL> --10. WAQTD EMP NAME AND MANAGER NAME ALONG WITH THEIR ANNUAL SALARIES IF EMPLOYEE WORKS IN DEPT 10, 20 AND MANAGER'S SAL IS GREATERTHAN EMPLOYEES SALARY.
SQL> SELECT E.ENAME E_ENAME,M.ENAME M_NAME,M.SAL*12 M_ANNUAL_SAL
  2  FROM EMP E,EMP M
  3  WHERE E.MGR=M.EMPNO
  4  AND (E.DEPTNO IN (10,20)) AND (M.SAL >E.SAL);

E_ENAME    M_NAME     M_ANNUAL_SAL                                                                                                                                                                      
---------- ---------- ------------                                                                                                                                                                      
MILLER     CLARK             29400                                                                                                                                                                      
ADAMS      SCOTT             36000                                                                                                                                                                      
CLARK      KING              60000                                                                                                                                                                      
JONES      KING              60000                                                                                                                                                                      
SMITH      FORD              36000    

                                                                                                                                                                  

