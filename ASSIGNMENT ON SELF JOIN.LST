SQL> --8. WAQTD EMP NAME AND MANAGER NAME IF BOTH ARE WORKING IN SAME JOB.
SQL> SELECT E.ENAME E_NAME,M.ENAME M_NAME
  2  FROM EMP E,EMP M
  3  WHERE E.MGR=M.EMPNO AND E.JOB=M.JOB;

