SQL> --7.WAQTD the name and salary along with the annual salary if the annual salary is more than 12000.
SQL> SELECT ENAME,SAL,SAL*12
  2  FROM EMP
  3  WHERE SAL*12>12000;

ENAME             SAL     SAL*12                                                                    
---------- ---------- ----------                                                                    
ALLEN            1600      19200                                                                    
