SQL> --1. WAQTD the annual salary of the employee whose name is SMITH.
SQL> SELECT SAL*12
  2  FROM EMP
  3  WHERE ENAME='SMITH';

    SAL*12                                                                                          
----------                                                                                          
      9600                                                                                          

