SQL> --.9. WAQTD the employee name and hire date if they were hired before the year 1981.
SQL> SELECT ENAME,HIREDATE
  2  FROM EMP
  3  WHERE HIREDATE<1981;
WHERE HIREDATE<1981
              *
ERROR at line 3:
ORA-00932: inconsistent datatypes: expected DATE got NUMBER 


SQL> SELECT ENAME,HIREDATE
  2  FROM EMP
  3  WHERE HIREDATE<'1981'
  4  ;
WHERE HIREDATE<'1981'
               *
ERROR at line 3:
ORA-01861: literal does not match format string 


SQL> SELECT ENAME,HIREDATE
  2  FROM EMP
  3  WHERE HIREDATE<'01-JAN-1981';

ENAME      HIREDATE                                                                                 
---------- ---------                                                                                
SMITH      17-DEC-80   
                                                                             

