      7844 TURNER     SALESMAN        7698 08-SEP-81       1500          0         30    
           

SQL> --4.List all the SALESMEN in DEPT 30 having salary greater than 1500.
SQL> SELECT *
  2  FROM EMP
  3  WHERE JOB IN ('SALESMAN') AND DEPTNO IN (30) AND SAL>1500;

     EMPNO ENAME      JOB              MGR HIREDATE         SAL       COMM     DEPTNO               
---------- ---------- --------- ---------- --------- ---------- ---------- ----------               
      7499 ALLEN      SALESMAN        7698 20-FEB-81       1600        300         30      

         

SQL> --5 5. List all the employees whose name starts with 'S' or 'A'.
SQL> SELECT *
  2  FROM EMP
  3  WHERE ENAME 'S%' OR 'A%'
  4  ;
WHERE ENAME 'S%' OR 'A%'
            *
ERROR at line 3:
ORA-00920: invalid relational operator 


SQL> SELECT *
  2  FROM EMP
  3  WHERE ENAME LIKE 'S%' OR 'A%';
WHERE ENAME LIKE 'S%' OR 'A%'
                            *
ERROR at line 3:
ORA-00920: invalid relational operator 


SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE ENAME LIKE 'S%' OR  LIKE 'A%';
WHERE ENAME LIKE 'S%' OR  LIKE 'A%'
                          *
ERROR at line 3:
ORA-00936: missing expression 


SQL> SELECT ENAME
  2  FROM EMP
  3  WHERE ENAME LIKE 'S%' OR  ENAME LIKE 'A%';

ENAME                                                                                               
----------                                                                                          
SMITH                                                                                               
ALLEN                                                                                               
SCOTT                                                                                               
ADAMS  
                                                                                             

