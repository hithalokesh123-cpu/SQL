SQL> --16.List all the employees who have reporting managers in DEPT 10 along with 10% hike in salary.
  1  SELECT ENAME,SAL+(SAL*10/100)
  2  FROM EMP
  3* WHERE (MGR IS NOT NULL AND DEPTNO IN 10)
SQL> /

ENAME      SAL+(SAL*10/100)                                                                         
---------- ----------------                                                                         
CLARK                  2695                                                                         
