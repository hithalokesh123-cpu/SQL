SQL> ---------------SCANARIO-2--------------------------
  1  SELECT COUNT(*),DEPTNO
  2  FROM EMP
  3* GROUP BY DEPTNO
  4  /

  COUNT(*)     DEPTNO                                                                               
---------- ----------                                                                               
         6         30                                                                               
         5         20                                                                               
         3         10                                                                               


SQL> ----------------------SCANARIO -3-------------------------
SQL> --SELECT(DEPTNO,SAL) AND GROUP BY(DEPTNO)
SQL> SELECT COUNT(*),DEPTNO,SAL
  2  FROM EMP
  3  GROUP BY DEPTNO;
SELECT COUNT(*),DEPTNO,SAL
                       *
ERROR at line 1:
