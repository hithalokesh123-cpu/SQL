SQL> --5.. WAQTD job and maximum salary of employees in each job if max salary exceeds 2600
SQL> SELECT JOB,MAX(SAL)
  2  FROM EMP
  3  GROUP BY JOB
  4  HAVING MAX(SAL)>2600;

JOB         MAX(SAL)                                                                                
--------- ----------                                                                                
PRESIDENT       5000                                                                                
MANAGER         2975                                                                                
