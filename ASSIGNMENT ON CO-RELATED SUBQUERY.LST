------------------COR-RELATED SUBQUERY------------------------------
SQL> --1. WAQTD NAME AND SALARY WHO IS EARNING STH MAXIMUM SALARY.
SQL> SELECT E1.ENAME,E1.SAL
  2  FROM EMP E1
  3  WHERE 5-1 IN (SELECT COUNT(DISTINCT E2.SAL)
  4                FROM EMP E2
  5                WHERE E1.SAL < E2.SAL);

ENAME             SAL                                                                                                                                                                                   
---------- ----------                                                                                                                                                                                   
CLARK            2450   
                                                                                                                                                                                

SQL> --2. WAQTD DETAILS OF THE EMP WHO IS EARING 4TH MINIMUM SALARY.
  1  SELECT *
  2  FROM EMP E1
  3  WHERE 4-1 IN (SELECT COUNT(DISTINCT E2.SAL)
  4                FROM EMP E2
  5*               WHERE E1.SAL>E2.SAL)
SQL> /

