SQL> --5. WAQTD 1ST, 2ND 4TH, 6TH, 7TH, MAXIMUM SALARIES.
SQL> SELECT E1.SAL
  2  FROM EMP E1
  3  WHERE (SELECT COUNT(DISTINCT E2.SAL)
  4         FROM EMP E2
  5         WHERE (E1.SAL<E2.SAL)) IN (0,1,3,5,6);

