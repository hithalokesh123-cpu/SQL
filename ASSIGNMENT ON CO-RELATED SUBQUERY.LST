SQL> --3. WAQTD DETAILS OF THE EMP WHO ARE EARNING TOP 5 MINIMUM SALARIES.
SQL> SELECT SAL
  2  FROM EMP E1
  3  WHERE (SELECT COUNT(DISTINCT E2.SAL)
  4         FROM EMP E2
  5         WHERE E1.SAL>E2.SAL) IN (0,1,2,3,4);

       SAL
----------
       800
      1250
      1250
      1100
       950
      1300

6 rows selected.

SQL> --4. WAQTD NAME AND SALARY OF THE EMP WHO ARE EARNING TOP 3 MINIMUM & TOP 3 MAXIMUM SALARIES.
SQL> SELECT E1.SAL
  2  FROM EMP E1
  3  WHERE (SELECT COUNT(DISTINCT E2.SAL)
  4         FROM EMP E2
  5         WHERE E1.SAL>E2.SAL) IN (0,1,2)
  6  OR (SELECT COUNT(DISTINCT E2.SAL)
  7         FROM EMP E3
  8         WHERE (E1.SAL<E3.SAL) IN (0,1,2);
