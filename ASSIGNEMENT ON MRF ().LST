2073.21429   
                                                                                       

SQL> --4.4. WAQTD NUMBER OF EMPLOYEES HAVING 'A' AS THEIR FIRST CHARACTER.
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE ENAME LIKE 'A%';

  COUNT(*)                                                                                          
----------                                                                                          
         2     
                                                                                     

SQL> --5 WAQTD NUMBER OF EMPLOYEES WORKING AS CLERK OR MANAGER.
SQL> SELECT COUNT(*)
  2  FROM EMP
  3  WHERE JOB IN('CLERK','MANAGER');

  COUNT(*)                                                                                          
----------                                                                                          
         7         
                                                                                 

SQL> --6.6. WAQTD TOTAL SALARY NEEDED TO PAY EMPLOYEES HIRED IN FEB.
SQL> SELECT SUM(SAL)
  2  FROM EMP
  3  WHERE HIREDATE LIKE ('%-FEB-%');

  SUM(SAL)                                                                                          
----------                                                                                          
      2850   
                                                                                       

