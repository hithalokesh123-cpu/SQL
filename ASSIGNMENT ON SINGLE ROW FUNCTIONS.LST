  2  FROM EMP
  3  WHERE TO_CHAR(HIREDATE,'MON')='JAN'
  4  AND TO_CHAR(HIREDATE,'DAY')='WEDNESDAY'
  5* AND TO_CHAR(HIREDATE,'HH24')='11'
