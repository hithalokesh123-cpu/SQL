SQL> --3. WAQTD DNAME AND ANNUAL SALARY FOR ALL EMPLOYEES WHOS SALARY IS MORE THAN 2340
SQL> SELECT DNAME,SAL*12 ANNUAL_SAL
  2  FROM EMP,DEPT
  3  WHERE  EMP.DEPTNO=DEPT.DEPTNO
  4  AND SAL > 2340;

DNAME          ANNUAL_SAL                                                                                                                                                                               
-------------- ----------                                                                                                                                                                               
ACCOUNTING          29400                                                                                                                                                                               
ACCOUNTING          60000                                                                                                                                                                               
RESEARCH            36000                                                                                                                                                                               
RESEARCH            36000                                                                                                                                                                               
RESEARCH            35700                                                                                                                                                                               
SALES               34200                                                                                                                                                                               

6 rows selected.



SQL> --4. WAQTD ENAME AND DNAME FOR EMPLOYEES HAVING CAHARACTER 'A' IN THEIR DNAME
SQL> SELECT ENAME,DNAME
  2  FROM EMP,DEPT
  3  WHERE EMP.DEPTNO=DEPT.DEPTNO
  4  AND DNAME LIKE '%A%';

