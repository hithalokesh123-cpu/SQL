SQL> --6. WADTD DNAME AND JOB FOR ALL THE EMPLOYEES WHOS JOB AND DNAME STARTS WITH CHARACTER 'S'
SQL> SELECT DNAME,JOB
  2  FROM EMP,DEPT
  3  WHERE  EMP.DEPTNO=DEPT.DEPTNO
  4  AND JOB LIKE 'S%' AND DNAME LIKE 'S%';

DNAME          JOB                                                                                                                                                                                      
-------------- ---------                                                                                                                                                                                
SALES          SALESMAN                                                                                                                                                                                 
SALES          SALESMAN                                                                                                                                                                                 
SALES          SALESMAN                                                                                                                                                                                 
SALES          SALESMAN      

                                                                                                                                                                           

SQL> --7. WAQTD, DNAME AND MGR NO FOR EMPLOYEES REPORTING TO 7839
  1  SELECT DNAME,MGR
  2  FROM EMP,DEPT
  3  WHERE EMP.DEPTNO=DEPT.DEPTNO
  4* AND MGR = 7839
SQL> /

DNAME                 MGR                                                                                                                                                                               
-------------- ----------                                                                                                                                                                               
