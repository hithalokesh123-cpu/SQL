SQL> --5. WAQTD ENAME AND DNAME FOR ALL THE EMPLOYEES WORKING AS SALESMAN
SQL> SELECT ENAME,DNAME
  2  FROM EMP
  3  ,DEPT
  4  WHERE EMP.DEPTNO=DEPT.DEPTNO
  5  AND JOB='SALESMAN';

