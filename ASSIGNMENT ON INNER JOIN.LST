SALES                7839                                                                                                                                                                               
ACCOUNTING           7839         

                                                                                                                                                                      

SQL> --8. WAQTD DNAME AND HIREDATE FOR EMPLOYEES HIRED AFTER 83 INTO ACCOUNTING OR RESEARCH DEPT
  1  SELECT DNAME,HIREDATE
  2  FROM EMP,DEPT
  3  WHERE  EMP.DEPTNO=DEPT.DEPTNO
  4* AND (HIREDATE > '31-DEC-1983') AND(DNAME IN ('ACCOUNTING','RESEARCH'))
SQL> /

DNAME          HIREDATE                                                                                                                                                                                 
-------------- ---------                                                                                                                                                                                
RESEARCH       23-MAY-87                                                                                                                                                                                
RESEARCH       19-APR-87   

                                                                                                                                                                             



SQL> --10. WAQTD DNAME AND EMPNO FOR ALL THE EMPLOYEES WHO'S EMPNO ARE (7839, 7902) AND ARE WORKING IN LOC NEW YORK.
  1  SELECT DNAME,EMPNO
  2  FROM EMP,DEPT
  3  WHERE EMP.DEPTNO=DEPT.DEPTNO
  4* AND (EMPNO IN (7839, 7902)) AND ( LOC='NEW YORK')
SQL> /

DNAME               EMPNO                                                                                                                                                                               
-------------- ----------                                                                                                                                                                               
ACCOUNTING           7839  

                                                                                                                                                                             

SQL> --9. WAQTD ENAME AND DNAME OF THE EMPLOYEES WHO ARE GETTING COMM IN DEPT 10 OR 30
  1  SELECT ENAME,DNAME
  2  FROM EMP,DEPT
  3  WHERE EMP.DEPTNO=DEPT.DEPTNO
  4* AND (COMM IS NOT NULL)AND (DEPT.DEPTNO IN (10,30))
SQL> /

