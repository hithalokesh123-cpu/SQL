SQL> --2. WAQTD DNAME AND SALARY FOR ALL THE EMPLOYEE WORKING IN ACCOUNTING.
  1  SELECT DNAME,SAL
  2  FROM EMP,DEPT
  3  WHERE EMP.DEPTNO=DEPT.DEPTNO
  4* AND DNAME='ACCOUNTING'
SQL> /

