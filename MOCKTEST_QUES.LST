SQL> --WAQTD ALL THE DETAILS OF EMPLOYEE ALONG WITH DESIGNATION,SALARY,DEPTNO SHOULD BE MERGED WHERE SALARY IS GREATER THAN 1500 AND JOB SHOULD BE SALESMAN,CLERK BUT NOT MANAGER
SQL> SELECT EMP.*,JOB||' '||SAL||' '||DEPTNO AS EMPLOYEE_DETAILS
  2  FROM EMP
  3  WHERE (SAL>1500 AND JOB IN ('SALESMAN','CLERK')) AND JOB<>'MANAGER';

