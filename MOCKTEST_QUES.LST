2)WAQT EMP NAME ,MANGER NAME, MANAGER'S LOC, IF EMPLOYEES ARE WORKING AS CLERK ANALYST AND  MANAGER ARE WORKING AS SALESMAN ,MANAGER AND MANAGER IS EARING 
4 DIGIT SAL, AND EMPLOYEE DESIGNATION SHOULD END WITH G S A N



1  SELECT E.ENAME,M.ENAME,ML.LOC
  2  FROM EMP E,EMP M,DEPT ML
  3  WHERE E.MGR=M.EMPNO
  4  AND M.DEPTNO=ML.DEPTNO
  5  AND E.JOB IN ('CLERK','ANALYST')
  6  AND M.JOB IN ('SALESMAN','MANAGER')
  7  AND M.SAL LIKE '____'
  8* AND (E.JOB LIKE '%G' OR E.JOB LIKE '%S' OR E.JOB LIKE '%A' OR E.JOB LIKE '%N')
SQL> /

no rows selected


SYNTAX:
CHAR(SIZE)
NUMBER(PRECISION,SCALE)
LECT 
SELECT GROUP FUNCTION /GROUP BY EXPRESSION
FROM TABLE NAME
WHERE < FILTER CONDITION>
GROUP BY COLNAME/EXPRESSION;

SELECT GROUP FUNCTION /GROUP BY EXPRESSION
FROM TABLE NAME
WHERE <FILTER CONDITION>
GROUP BY COLNAME/EXPRESSION
ORDER BY GROUP BY EXPRESSION;

SELECT COL NAME/EXP
FROM TABLE NAME1 LEFT[OUTER] JOIN TABLE NAME2
ON <JOIN CONDITION>;

SELECT COL_NAME/EXPR
FROM TABLE NAME 
WHERE COLNAME BETWEEN HIGHEST RANGE AND LOWEST RANGE;

DROP TABLE TABLE_NAME;

ALTER TABLE TABLE_NAME
ADD CONSTRAINT CON_REFERENCE_NAME CONSTRAINT_TYPE(COL_NAM)
REFERENCES PARENT_TABLE_NAME(COL_NAME)

