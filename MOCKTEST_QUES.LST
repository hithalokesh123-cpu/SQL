--WAQTD DNAME IF SALARY ENDS WITH 0,1,5 AND HIRED IN THE MONTH OF 'FEB','MAR','APR','SEPT'
 1  SELECT DNAME
  2  FROM DEPT
  3  WHERE DEPTNO IN (SELECT  DEPTNO
  4                   FROM EMP
  5                   WHERE SAL LIKE '%0' OR SAL LIKE '%1' OR SAL LIKE '%5'
  6* AND HIREDATE LIKE '%FEB%' OR HIREDATE LIKE '%MAR%' OR HIREDATE LIKE '%APR%' OR HIREDATE LIKE '%SEPT%')
SQL> /

DNAME
--------------
ACCOUNTING
RESEARCH
SALES

