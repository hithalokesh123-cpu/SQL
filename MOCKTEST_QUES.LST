--WAQTD EMPLOYEE NAME IF THEY ARE EARNING 4 DIGIT SALARY AND THEIR DESOIGNATION SATART WITH 'A','S','M'  AND ENDS WITH 'T','R','N' AND
WORKING IN THE LOC 'CHICAGO','DALLAS','BOSTEN'
1  SELECT ENAME
  2  FROM EMP
  3  WHERE SAL LIKE '____'
  4  AND ( JOB LIKE 'A%' OR JOB LIKE 'S%' OR JOB LIKE 'M%')
  5  AND (JOB LIKE '%T' OR JOB LIKE '%R' OR JOB LIKE '%N')
  6  AND DEPTNO IN ( SELECT DEPTNO
  7                   FROM DEPT
  8*                   WHERE LOC IN ('CHICAGO','DALLAS','BOSTON'))
SQL> /

