1)WRITE  TO DISPLAY  EMPLOYEE NAME ,HIREDATE  SAL , WHO ARE EARNING 3 4 MINIMUM SAL OR 8 TH MAXIMUM SAL


SELECT E1.ENAME,E1.HIREDATE,E1.SAL
