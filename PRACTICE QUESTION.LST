 --1) Display the department numbers along with the number of employees in it
SQL> SELECT DEPTNO,COUNT(*)
  2  FROM EMP
  3  GROUP BY DEPTNO;

    DEPTNO   COUNT(*)
---------- ----------
        30          6
        20          5
        10          3
--2) Display the department numbers which are having more than 4 employees in them
SQL> SELECT COUNT(*),DEPTNO
  2  FROM EMP
  3  GROUP BY DEPTNO
  4  HAVING COUNT(*)>4;

  COUNT(*)     DEPTNO
---------- ----------
         6         30
         5         20

