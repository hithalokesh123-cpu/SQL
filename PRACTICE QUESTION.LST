SQL> --1) Display the total salary of all departments
SQL> SELECT SUM(SAL)
  2  ,DEPTNO
  3  FROM EMP
  4  GROUP BY DEPTNO;

  SUM(SAL)     DEPTNO                                                                               
---------- ----------                                                                               
      9400         30                                                                               
     10875         20                                                                               
      8750         10                                                                               

SQL> 2) Display the maximum salary of each job
 SELECT MAX(SAL),JOB
  2  FROM EMP
  3  GROUP BY JOB;

  MAX(SAL) JOB
---------- ---------
      1300 CLERK
      1600 SALESMAN
      5000 PRESIDENT
      2975 MANAGER
      3000 ANALYST

 --3)Display job-wise highest salary only if the highest salary is more than Rs1500
SQL> SELECT JOB,MAX(SAL)
  2  FROM EMP
  3  WHERE SAL>1500
  4  GROUP BY JOB;

JOB         MAX(SAL)
--------- ----------
SALESMAN        1600
PRESIDENT       5000
MANAGER         2975
ANALYST         3000


-- --4) Display job-wise highest salary only if the highest salary is more than 1500 excluding department 30. Sort the data based on highest salary in the ascending order.And then we have to be
SQL> SELECT JOB,MAX(SAL)
  2  FROM EMP
  3  WHERE  DEPTNO<>30
  4  GROUP BY JOB
  5  HAVING MAX(SAL)>1500
  6  ORDER BY MAX(SAL);

JOB         MAX(SAL)
--------- ----------
MANAGER         2975
ANALYST         3000
PRESIDENT       5000


